# Copy to .env for local development: cp .env.example .env
# These values are for the local SQL Server container only and are never used on Azure.
# SQL Server requires 8+ characters with upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=Local-Only-Sa-1
LEARNING_DB_PASSWORD=Local-Only-Learning-1
PROJECTS_DB_PASSWORD=Local-Only-Projects-1
# Shared key the two services use to call each other (X-Internal-Key). Local only.
INTERNAL_API_KEY=local-only-internal-key
